{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build OpenGL Project",
            "command": "g++.exe",
            "args": [
         
    "-fdiagnostics-color=always",
    "-g",
    "${workspaceFolder}/*.cpp",
    "${workspaceFolder}/glad.c",
    "-o",
    "${workspaceFolder}/main.exe",
    "-I${workspaceFolder}/Dependencies/include",
    "-L${workspaceFolder}/Dependencies/lib",
    "-lglfw3",
    "-lopengl32",
    "-lgdi32",
    "-luser32",
    "-lkernel32",
    "-lshell32"

            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}